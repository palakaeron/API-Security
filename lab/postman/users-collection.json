            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "url": {
              "raw": "http://127.0.0.1:8102/vuln/profiles/{{user_id}}",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8102",
              "path": ["vuln", "profiles", "{{user_id}}"],
              "variable": [{ "key": "user_id", "value": "alice" }]
            }
          }
        },
        {
          "name": "Vulnerable – Update profile (BOPLA write target)",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"display_name\": \"Updated Name\"}"
            },
            "url": {
              "raw": "http://127.0.0.1:8102/vuln/profiles/{{user_id}}",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8102",
              "path": ["vuln", "profiles", "{{user_id}}"],
              "variable": [{ "key": "user_id", "value": "alice" }]
            }
          }
        },
        {
          "name": "Secure – Get profile (ownership enforced)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "url": {
              "raw": "http://127.0.0.1:8102/secure/profiles/{{user_id}}",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8102",
              "path": ["secure", "profiles", "{{user_id}}"],
              "variable": [{ "key": "user_id", "value": "alice" }]
            }
          }
        },
        {
          "name": "Secure – Update profile (own display name only)",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"display_name\": \"Updated Name\"}"
            },
            "url": {
              "raw": "http://127.0.0.1:8102/secure/profiles/{{user_id}}",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8102",
              "path": ["secure", "profiles", "{{user_id}}"],
              "variable": [{ "key": "user_id", "value": "alice" }]
            }
          }
        }
      ]
    }
  ]
}
