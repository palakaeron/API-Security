# Copy to .env for local development. These are placeholders, not production secrets.
# SQLite is the native-development default; no database server is required.
DATABASE_URL=sqlite:///./api-security.db
SESSION_SECRET=replace-with-a-local-random-session-secret
LAB_SECURE_JWT_SECRET=replace-with-a-local-random-lab-secret
CONTROLLED_TARGET_HOSTS=localhost,127.0.0.1,::1
CONTROLLED_TARGET_CIDRS=127.0.0.0/8,::1/128
